---
interface Props {
  tone?: "light" | "dark";
  id?: string;
}
const { tone = "light", id } = Astro.props;
const toneClass =
  tone === "dark"
    ? "bg-[var(--color-surface-dark)] text-[var(--color-body-dark)]"
    : "bg-surface text-[var(--color-body)]";
---

<!--
  data-tone lets global.css collapse the seam between two consecutive
  sections of the SAME tone, which would otherwise stack two full vertical
  paddings and read as dead space. A tone CHANGE keeps both paddings —
  there the space is doing work.
-->
<section id={id} class={toneClass} data-tone={tone}>
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <slot />
  </div>
</section>
